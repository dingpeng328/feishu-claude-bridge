# ============================================================
# feishu-agent-bridge 配置 — 复制本文件为 .env 并填真实值
# ============================================================

# 飞书自建应用凭证(开放平台 → 你的 app → 凭证与基础信息)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (可选)机器人自身 open_id —— 仅用于日志展示,不填也能跑
FEISHU_BOT_OPEN_ID=

# (可选)群白名单:逗号分隔的 chat_id;留空 = 任何群 @ 都响应
# 例: ALLOWED_CHAT_IDS=oc_aaa,oc_bbb
ALLOWED_CHAT_IDS=

# (可选)Agent 运行的工作目录(所有话题共享同一个 cwd)。
#   留空 = ~/.feishu-claude-bridge/work(干净的独立 scratch,纯对话助手)
#   设成一个项目仓库 = 机器人能读该仓库代码、加载项目指令/技能
# 注:sessions.json / bridge.pid 始终放在 ~/.feishu-claude-bridge/,不会污染这个目录
WORK_DIR=

# (可选)桥接的本地 Agent。可选: claude / codex；本示例使用本地 Codex。
AGENT_KIND=codex

# (可选)Agent 可执行文件路径。AGENT_KIND=claude 时默认 claude；AGENT_KIND=codex 时默认 codex。
AGENT_BIN=codex

# 注意:AGENT_KIND=codex 时 bridge 会用
#   codex --dangerously-bypass-approvals-and-sandbox exec --json ...
# 即完全放开 Codex 沙箱和审批,以便访问网络和本机资源。请只把机器人放进可信群。

# (兼容旧配置)claude 可执行文件路径；新配置优先用 AGENT_BIN。
CLAUDE_BIN=claude

# (可选)单轮 Agent 子进程超时(毫秒),默认 1800000 (30 分钟)
SUBPROCESS_TIMEOUT_MS=

# (可选)飞书长连接自愈与消息补拉。设 0 可分别关闭对应能力。
# 即使 WS 看起来仍在线，也会定期重建，避免“进程活着但收不到消息”。默认 20 分钟。
FCB_CHANNEL_REFRESH_MS=1200000
# 每分钟通过历史消息接口补拉遗漏的 @；需要应用权限 im:message.group_msg。
# delivery-state.json 持久化游标并按 message_id 去重。
FCB_CATCHUP_INTERVAL_MS=60000
# 首次启用补拉时只回看最近 5 分钟；之后按持久化游标连续补拉。
FCB_CATCHUP_LOOKBACK_MS=300000
