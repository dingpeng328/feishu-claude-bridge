# 微信 bridge 使用独立配置文件；不会读取飞书 .env 中的业务配置。
WECHAT_AGENT_BIN=codex
WECHAT_WORK_DIR=/Users/yourname/Documents/workspace

# Codex 执行权限：read-only 或 workspace-write。
WECHAT_CODEX_SANDBOX=workspace-write
WECHAT_CODEX_APPROVE_FOR_ME=true

# 可选项
# WECHAT_AGENT_SYSTEM_PROMPT="你是通过微信工作的本地 Codex 助手。"
# WECHAT_SUBPROCESS_TIMEOUT_MS=1800000
# WECHAT_STATE_DIR=/Users/yourname/.wechat-codex-bridge
# WECHAT_API_BASE_URL=https://ilinkai.weixin.qq.com
# WECHAT_BOT_TYPE=3
# WECHAT_BOT_AGENT=WechatCodexBridge/0.1.0
