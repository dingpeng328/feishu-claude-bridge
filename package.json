{
  "name": "feishu-claude-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Feishu and WeChat bridges to local Claude/Codex CLI",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:feishu": "tsx src/main.ts",
    "start:wechat": "tsx src/wechat-main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@larksuite/channel": "0.6.1",
    "dotenv": "^16.4.0",
    "qrcode-terminal": "0.12.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
